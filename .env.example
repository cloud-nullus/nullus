# Server
NULLUS_SERVER_PORT=8090
NULLUS_SERVER_MODE=development

# Database
# 이름은 설정 키(configs/config.yaml 의 database.*)를 그대로 따른다.
# NULLUS_DB_* 는 어느 키와도 맞지 않아 조용히 무시된다.
NULLUS_DATABASE_HOST=localhost
NULLUS_DATABASE_PORT=5433
NULLUS_DATABASE_NAME=nullus
NULLUS_DATABASE_USER=nullus
NULLUS_DATABASE_PASSWORD=nullus_dev
NULLUS_DATABASE_SSLMODE=disable

# Auth
NULLUS_AUTH_MODE=session
NULLUS_AUTH_SESSION_SECRET=dev-secret-change-in-production

# Encryption (must be exactly 32 bytes)
ENCRYPTION_KEY=nullus-dev-key-32bytes-padding!!

# 오브젝트 스토리지는 백업 목적지로만 설정한다 — 설정 키는 backup.destination.* 다.
# 기본값은 backup.enabled=false 이므로 백업을 쓸 때만 채운다.
# NULLUS_BACKUP_DESTINATION_ENDPOINT=localhost:9000
# NULLUS_BACKUP_DESTINATION_BUCKET=nullus-backup
# NULLUS_BACKUP_DESTINATION_ACCESS_KEY=nullus
# NULLUS_BACKUP_DESTINATION_SECRET_KEY=nullus_dev
# NULLUS_BACKUP_DESTINATION_USE_SSL=false
# 봉인 키는 정확히 32바이트이고 ENCRYPTION_KEY 와 달라야 한다.
# NULLUS_BACKUP_SEAL_KEY=
